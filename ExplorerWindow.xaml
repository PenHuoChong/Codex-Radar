<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目 / 对话用量（手动查询）" Width="1120" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6F8" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="Reload" Content="刷新项目 / 对话" Padding="10,6"/>
      <Button x:Name="Backfill" Content="补齐 / 更新全部历史日志" Padding="10,6" Margin="8,0"/>
      <Button x:Name="Titles" Content="读取对话名称…" Padding="10,6"/>
      <Button x:Name="Cancel" Content="取消查询" Padding="10,6" Margin="8,0" IsEnabled="False"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="独立查询，不改变主界面的测量范围。点击项目汇总项目，点击对话包含其子代理；仅手动操作触发。" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,10,0,0">
        <ComboBox x:Name="Range" Width="130" SelectedIndex="0">
          <ComboBoxItem Content="最近24小时" Tag="1"/><ComboBoxItem Content="最近7天" Tag="7"/>
          <ComboBoxItem Content="最近30天" Tag="30"/><ComboBoxItem Content="自定义" Tag="custom"/>
          <ComboBoxItem Content="全部时间" Tag="all"/>
        </ComboBox>
        <TextBox x:Name="From" Width="165" Margin="8,0,0,0" ToolTip="本地时间 yyyy-MM-dd HH:mm:ss"/>
        <TextBlock Text=" 至 " VerticalAlignment="Center"/>
        <TextBox x:Name="To" Width="165" ToolTip="本地时间 yyyy-MM-dd HH:mm:ss"/>
        <Button x:Name="Query" Content="查询所选项" Margin="8,0,0,0" Padding="10,4"/>
      </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TreeView x:Name="Tree"/>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="Selection" Text="请选择项目或对话" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,12" FontSize="17" TextWrapping="Wrap"/>
        <TextBlock x:Name="Coverage" Grid.Row="2" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#685522"/>
        <DataGrid x:Name="Models" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="模型 / 模式" Binding="{Binding Model}" Width="*"/>
            <DataGridTextColumn Header="缓存输入" Binding="{Binding Cached}" Width="90"/>
            <DataGridTextColumn Header="未缓存输入" Binding="{Binding Uncached}" Width="95"/>
            <DataGridTextColumn Header="输出" Binding="{Binding Output}" Width="85"/>
            <DataGridTextColumn Header="总 Token" Binding="{Binding Total}" Width="95"/>
            <DataGridTextColumn Header="美元" Binding="{Binding Cost}" Width="85"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="仅使用本机可观察 Token；美元为 API 等价成本。"/>
  </Grid>
</Window>
